{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/cron/membership-expiration",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/membership/internal/cron/sweep-pending",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/events/internal/cron/sweep-stale-registrations",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/shop/internal/cron/expire-pending",
      "schedule": "0 * * * *"
    }
  ]
}
