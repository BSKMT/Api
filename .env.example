# BSK Motorcycle Team — NestJS API Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git (it is in .gitignore).

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=app
BETTER_AUTH_SECRET=your-secret-min-32-chars-here
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=https://bskmt.com
PORT=3000

# ─── Bold (Payment Gateway) ──────────────────────────────────────────
BOLD_IDENTITY_KEY=your-bold-identity-key
BOLD_SECRET_KEY=your-bold-secret-key
BOLD_PUBLIC_KEY=your-bold-public-key
BOLD_ENVIRONMENT=sandbox

LANDING_PAGE_URL=https://bskmt.com
CRON_SECRET=your-cron-secret-min-16-chars
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ─── Bird — Email, SMS, Verify ───────────────────────────────────────
# API key from Bird dashboard > Developers > API keys.
# Format: bk_us1_... (US region) or bk_eu1_... (EU region).
# If not set or invalid, email/SMS/verify silently degrade (no-op + log).
BIRD_API_KEY=
BIRD_FROM_EMAIL=no_responder@bskmt.com
BIRD_FROM_NAME=BSK Motorcycle Team
BIRD_TEAM_EMAIL=contacto@bskmt.com
BIRD_SMS_SENDER=BSKMT

# ─── Bird Realtime — WebSocket Hosted Service ─────────────────────────
# From Bird dashboard > Realtime > Apps > your app.
# APP_ID format: rap_...
# KEY is public (safe to ship to the browser via Astro).
# SECRET is server-only — NEVER expose to the client.
# If any of the three required values is missing, realtime degrades to
# a no-op and the polling fallback (60s/15s) continues to work.
BIRD_REALTIME_APP_ID=
BIRD_REALTIME_KEY=
BIRD_REALTIME_SECRET=
BIRD_REALTIME_REGION=us1

# Webhook signing secret for verifying realtime.* webhook deliveries.
# From Bird dashboard > Developers > Webhooks > your endpoint.
# Optional but strongly recommended (OWASP A08 — data integrity).
BIRD_WEBHOOK_SECRET=

# ─── Cloudflare Workers KV (optional) ────────────────────────────────
CF_KV_ENABLED=false
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID_PUBLIC=
CF_KV_NAMESPACE_ID_PRIVATE=
CF_KV_API_TOKEN=

# ─── AbuseIPDB — IP Reputation ───────────────────────────────────────
ABUSEIPDB_ENABLED=false
ABUSEIPDB_API_KEY=
ABUSEIPDB_BLOCK_THRESHOLD=75