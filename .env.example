# BSK Motorcycle Team — NestJS API Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git (it is in .gitignore).

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=app
BETTER_AUTH_SECRET=your-secret-min-32-chars-here
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=https://bskmt.com
PORT=3000

# ─── Passkeys (WebAuthn / Android Credential Manager) ──────────────────
PASSKEY_RP_ID=bskmt.com
# Opcional: orígenes WebAuthn extra separados por coma (ej. staging HTTPS o android:apk-key-hash:<base64url> de QA)
PASSKEY_EXTRA_ORIGINS=

# ─── Bold (Payment Gateway) ──────────────────────────────────────────
BOLD_IDENTITY_KEY=your-bold-identity-key
BOLD_SECRET_KEY=your-bold-secret-key
BOLD_PUBLIC_KEY=your-bold-public-key
BOLD_ENVIRONMENT=sandbox

LANDING_PAGE_URL=https://bskmt.com
CRON_SECRET=your-cron-secret-min-16-chars
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ─── Mapbox — Geocodificación y Rutas Satelitales (ARPHA) ───────────
# Token de acceso público o secreto de Mapbox para geocodificación inversa y cálculo de rutas
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# ─── Bird — Email, SMS, WhatsApp, Verify ────────────────────────────
# API key from Bird dashboard > Developers > API keys.
# Format: bk_us1_... (US region) or bk_eu1_... (EU region).
# If not set or invalid, email/SMS/verify silently degrade (no-op + log).
BIRD_API_KEY=
BIRD_FROM_EMAIL=no_responder@bskmt.com
BIRD_FROM_NAME=BSK Motorcycle Team
BIRD_TEAM_EMAIL=contacto@bskmt.com
BIRD_SMS_SENDER=BSKMT

# Bird CRM — Audiencias para segmentación y marketing
# IDs de las audiencias estáticas en Bird CRM (Contacts & Audiences)
BIRD_AUDIENCE_USERS_ID=adn_01m10ftkpeeyz9hmdk1ahy3s1h
BIRD_AUDIENCE_MEMBERS_ID=adn_01m10fv8axe26v3v646cmwj63s
BIRD_AUDIENCE_EMPLOYEES_ID=adn_01m5g854wbe05snnxfb17zct16
BIRD_AUDIENCE_ADMINS_ID=adn_01m10fw0chfqfseb3c4260yghq

# WhatsApp sender — E.164 phone number owned by the workspace and
# connected to a WhatsApp Business Account (WABA) in Bird dashboard >
# WhatsApp > Numbers. Required for free-form text notifications.
# If empty or invalid, WhatsApp silently degrades (no-op + log).
# Format: +<country><number> (ej: +13124495648)
BIRD_WHATSAPP_SENDER=

# ─── Bird Realtime — WebSocket Hosted Service ─────────────────────────
# From Bird dashboard > Realtime > Apps > your app.
# APP_ID format: rap_...
# KEY is public (safe to ship to the browser via Astro).
# SECRET is server-only — NEVER expose to the client.
# If any of the three required values is missing, realtime degrades to
# a no-op and the polling fallback (60s/15s) continues to work.
BIRD_REALTIME_APP_ID=
BIRD_REALTIME_KEY=
BIRD_REALTIME_SECRET=
BIRD_REALTIME_REGION=us1

# Webhook signing secret for verifying realtime.* webhook deliveries.
# From Bird dashboard > Developers > Webhooks > your endpoint.
# Optional but strongly recommended (OWASP A08 — data integrity).
BIRD_WEBHOOK_SECRET=

# ─── Cloudflare Workers KV (optional) ────────────────────────────────
CF_KV_ENABLED=false
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID_PUBLIC=
CF_KV_NAMESPACE_ID_PRIVATE=
CF_KV_API_TOKEN=

# ─── Verifik — Identity Verification (KYC Colombia) ──────────────────
# Bearer token from the Verifik dashboard (https://verifik.co > Cuenta > API).
# Server-side secret — NEVER expose to the client or commit the real value.
# Supports Colombian documents: CC (cédula premium), CE, PPT and PEP
# (foreigner-id routes via Migración Colombia).
# If empty, identity verification endpoints return 503 and transactional
# endpoints (membership purchase, event/course registration, shop orders,
# ARPHA) keep working as before (feature flag OFF).
VERIFIK_API_TOKEN=
VERIFIK_API_URL=https://api.verifik.co
VERIFIK_TIMEOUT_MS=15000

# ─── Alegra — Facturación Electrónica (Colombia) ─────────────────────
# Credenciales desde app.alegra.com > Configuración > API.
# ALEGRA_EMAIL + ALEGRA_TOKEN forman el Basic Auth header (Base64).
# Si ALEGRA_ENABLED es false, la facturación se omite sin afectar pagos.
# Auto-descubrimiento dinámico desde la API de Alegra:
# - ALEGRA_ITEM_ID: ID del item para facturas (auto-descubierto dinámicamente vía API).
# - ALEGRA_BANK_ACCOUNT_ID: ID de cuenta bancaria para registrar pagos (auto-descubierto dinámicamente vía API).
# - ALEGRA_SELLER_ID: ID del vendedor asignado a facturas (auto-descubierto dinámicamente vía API).
# - ALEGRA_WEBHOOK_SECRET: Token para validar webhooks entrantes de Alegra (obligatorio si webhook activo).
ALEGRA_ENABLED=false
ALEGRA_EMAIL=
ALEGRA_TOKEN=
ALEGRA_API_URL=https://api.alegra.com/api/v1
ALEGRA_TIMEOUT_MS=30000
ALEGRA_BANK_ACCOUNT_ID=
ALEGRA_SELLER_ID=
ALEGRA_ITEM_ID=
ALEGRA_NUMBER_TEMPLATE_ID=
ALEGRA_WEBHOOK_SECRET=

# ─── Talleres Aliados — Autenticación de Servicios Certificados ────────
# Lista de tokens separados por coma para autorización de talleres aliados (o token:NombreTaller)
ALLIED_WORKSHOP_TOKENS=your_allied_workshop_token_here

# ─── Cloudinary — Media & Asset Platform ──────────────────────────────
# Configuración de Cloudinary para subida, optimización y entrega de imágenes/videos
# Obten tus credenciales en https://console.cloudinary.com > Dashboard / Settings > API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# O alternativamente formato CLOUDINARY_URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ─── Seguridad CSRF y Origen Cloudflare (Edge / BFF) ─────────────────
# Secreto dedicado para firmar HMAC de bskmt.csrf (si se omite, se deriva de BETTER_AUTH_SECRET)
CSRF_SECRET=
# Secreto compartido entre BFFs/Cloudflare Transform Rule y la API para verificar origen
CF_ORIGIN_SECRET=
# Secreto compartido entre cloudflare-edge Worker (Queues/Workflows) y /api/internal/*
INTERNAL_EDGE_SECRET=
# URL base del panel de miembros (para enlaces de correo y redirecciones)
PANEL_URL=https://dash.bskmt.com
